#include <LPC214x.h>
void set_pll() {
    PLL0CON = 0x01;
    PLL0CFG = 0x24;
    PLL0FEED = 0xAA;
    PLL0FEED = 0x55;
    while((PLL0STAT & (1<<10)) == 0);
    PLL0CON = 0x03;
    PLL0FEED = 0xAA;
    PLL0FEED = 0x55;
}

int main() {
    set_pll();
    IO0DIR |= (1<<10);
    while(1) {
        IO0SET = (1<<10);
        IO0CLR = (1<<10);
    }
}
