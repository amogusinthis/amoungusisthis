#include <lpc214x.h>
void delay(unsigned int ms) {
    unsigned int i, j;
    for(i=0; i<ms; i++)
        for(j=0; j<6000; j++);
}

void dac_init() {
    PINSEL1 = 0x00040000;
}

void dac_write(unsigned int data) {
    DACR = (data << 6);
}

int main(void) {
    unsigned int dac_value;
    dac_init();
    for(dac_value = 0; dac_value <= 1023; dac_value++) {
        dac_write(dac_value);
        delay(10);
    }
}
