#include <LPC214x.h>
#define RS (1<<16)
#define EN (1<<17)
#define D4 (1<<18)
#define D5 (1<<19)
#define D6 (1<<20)
#define D7 (1<<21)

void delay(unsigned int t) {
    unsigned int i, j;
    for(i=0; i<t; i++)
        for(j=0; j<1200; j++);
}

void lcd_pulse() {
    IO0SET = EN;
    delay(1);
    IO0CLR = EN;
}

void lcd_data(unsigned char data) {
    IO0CLR = D4 | D5 | D6 | D7;
    if(data & 0x01) IO0SET = D4;
    if(data & 0x02) IO0SET = D5;
    if(data & 0x04) IO0SET = D6;
    if(data & 0x08) IO0SET = D7;
    lcd_pulse();
}

void lcd_cmd(unsigned char cmd) {
    IO0CLR = RS;
    lcd_data(cmd >> 4);
    lcd_data(cmd & 0x0F);
    delay(2);
}

void lcd_char(unsigned char data) {
    IO0SET = RS;
    lcd_data(data >> 4);
    lcd_data(data & 0x0F);
    delay(2);
}

void lcd_init() {
    IO0DIR |= RS | EN | D4 | D5 | D6 | D7;
    delay(20);
    lcd_cmd(0x02);
    lcd_cmd(0x28);
    lcd_cmd(0x0C);
    lcd_cmd(0x06);
    lcd_cmd(0x01);
    delay(5);
}

void lcd_string(char *str) {
    while(*str) {
        lcd_char(*str);
        str++;
    }
}

int main() {
    lcd_init();
    lcd_string("Embedded System");
    while(1);
}
