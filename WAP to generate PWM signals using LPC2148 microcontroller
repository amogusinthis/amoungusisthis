#include <LPC214x.h>
void pwm_init() {
    PINSEL0 = 0x00008002; // PWM1 (P0.0) and PWM2 (P0.7)
    PWMPCR = 0x00000600;  // to enable PWM1 and PWM2
    PWMMR0 = 150000;      // holds the total time of cycle (Ton+Toff)
    PWMTCR = 0x09;        // enables timer counter and prescaler also enables pwm mode
    PWMMCR = 0x02;        // to reset PWMTC after match
}

int main(void) {
    pwm_init();
    while(1) {
        PWMMR2 = 90000;   // (90000/150000)*100 = 60%
        PWMLER = 0x06;
        PWMMR1 = 75000;   // (75000/150000)*100 = 50%
    }
}
