#include <lpc214x.h>
void delay_ms(unsigned int ms) {
    T0TC = 0;
    T0PC = 0;
    T0PR = 12000 - 1;
    T0TCR = 0x01;
    while(T0TC < ms);
    T0TCR = 0;
}

int main() {
    IODIR0 |= (1<<0);
    while(1) {
        IOSET0 |= (1<<0);
        delay_ms(1);
        IOCLR0 |= (1<<0);
        delay_ms(1);
    }
}
